diff --git a/src/renderer/wgpu/pipeline_cache_tests.rs b/src/renderer/wgpu/pipeline_cache_tests.rs
new file mode 100644
index 0000000..6fdb6d8
--- /dev/null
+++ b/src/renderer/wgpu/pipeline_cache_tests.rs
@@ -0,0 +1,262 @@
+use crate::{
+    renderer::WGPURenderer, BlendFactor, Canvas, Color, DrawCommand, FillRule, GlyphDrawCommands, ImageFilter,
+    ImageFlags, LayerEffects, Paint, Path, PixelFormat, Quad,
+};
+
+use std::{cell::Cell, collections::HashMap};
+
+use super::{evict_least_recently_used, PIPELINE_CACHE_CAPACITY};
+
+#[path = "../../../tests/common/device.rs"]
+mod device;
+use device::headless_device;
+
+thread_local! {
+    pub(super) static CREATED_PIPELINES: Cell<usize> = const { Cell::new(0) };
+}
+
+/// Large enough to hold every shape the tests draw; the tests count pipelines, not pixels.
+const SIZE: u32 = 64;
+
+fn target(device: &wgpu::Device) -> wgpu::Texture {
+    device.create_texture(&wgpu::TextureDescriptor {
+        label: Some("pipeline cache target"),
+        size: wgpu::Extent3d {
+            width: SIZE,
+            height: SIZE,
+            depth_or_array_layers: 1,
+        },
+        mip_level_count: 1,
+        sample_count: 1,
+        dimension: wgpu::TextureDimension::D2,
+        format: wgpu::TextureFormat::Rgba8Unorm,
+        usage: wgpu::TextureUsages::RENDER_ATTACHMENT,
+        view_formats: &[],
+    })
+}
+
+#[derive(Debug)]
+struct FlushCounts {
+    created: usize,
+    retained: usize,
+}
+
+fn flush_counts(
+    device: &wgpu::Device,
+    queue: &wgpu::Queue,
+    canvas: &mut Canvas<WGPURenderer>,
+    target: &wgpu::Texture,
+) -> FlushCounts {
+    let before = CREATED_PIPELINES.get();
+    let commands = canvas
+        .flush_to_output(target)
+        .expect("flush_to_output produced no command buffer for a flush with draws");
+    queue.submit([commands]);
+    // Evicted pipelines are freed once no submission holds them.
+    device
+        .poll(wgpu::PollType::wait_indefinitely())
+        .expect("device poll failed");
+    let live = device.get_internal_counters().hal.render_pipelines.read();
+    // Without the `counters` feature every counter reads zero, and the tests' comparisons would pass vacuously.
+    assert!(
+        live > 0,
+        "no live render pipelines counted; is wgpu's `counters` feature on?"
+    );
+    let retained = canvas.renderer.pipeline_cache.borrow().len();
+    assert_eq!(live as usize, retained, "live pipelines differ from cache entries");
+    FlushCounts {
+        created: CREATED_PIPELINES.get() - before,
+        retained,
+    }
+}
+
+fn rect() -> Path {
+    let mut path = Path::new();
+    path.rect(8.0, 8.0, 40.0, 40.0);
+    path
+}
+
+/// Clears the target, then draws a solid, a gradient and a scissored concave fill and a stroke.
+fn draw_frame(canvas: &mut Canvas<WGPURenderer>) {
+    canvas.clear_rect(0, 0, SIZE, SIZE, Color::white());
+    canvas.fill_path(&rect(), &Paint::color(Color::rgb(255, 0, 0)));
+    let mut circle = Path::new();
+    circle.circle(40.0, 40.0, 12.0);
+    let gradient = Paint::linear_gradient(0.0, 0.0, 64.0, 64.0, Color::black(), Color::white());
+    canvas.fill_path(&circle, &gradient);
+    canvas.stroke_path(&circle, &Paint::color(Color::rgb(0, 0, 255)).with_line_width(3.0));
+    canvas.save();
+    canvas.scissor(0.0, 0.0, 30.0, 30.0);
+    let mut concave = Path::new();
+    concave.move_to(0.0, 0.0);
+    concave.line_to(60.0, 10.0);
+    concave.line_to(10.0, 60.0);
+    concave.line_to(50.0, 50.0);
+    concave.close();
+    canvas.fill_path(&concave, &Paint::color(Color::rgb(0, 128, 0)));
+    canvas.restore();
+}
+
+/// The clear is a separate pipeline and is included in each working-set size.
+#[test]
+fn pipeline_creations_and_residency_across_capacity() {
+    let Some((device, queue)) = headless_device() else {
+        return;
+    };
+    let target = target(&device);
+    let capacity = PIPELINE_CACHE_CAPACITY;
+    let factors = [
+        BlendFactor::One,
+        BlendFactor::OneMinusSrcAlpha,
+        BlendFactor::Zero,
+        BlendFactor::SrcColor,
+        BlendFactor::OneMinusSrcColor,
+        BlendFactor::DstColor,
+        BlendFactor::OneMinusDstColor,
+        BlendFactor::SrcAlpha,
+        BlendFactor::DstAlpha,
+        BlendFactor::OneMinusDstAlpha,
+    ];
+    for states in [capacity - 1, capacity, capacity + 1, 80, 129] {
+        let mut canvas = Canvas::new(WGPURenderer::new(device.clone(), queue.clone())).expect("canvas");
+        canvas.set_size(SIZE, SIZE, 1.0);
+        let red = Paint::color(Color::rgb(255, 0, 0)).with_anti_alias(false);
+        let path = rect();
+        for round in 0..3 {
+            canvas.save();
+            for i in 0..states - 1 {
+                // No anti-aliasing: each distinct blend state needs one pipeline.
+                canvas.global_composite_blend_func_separate(
+                    factors[i % 10],
+                    factors[(i / 10) % 10],
+                    if i < 100 { BlendFactor::One } else { BlendFactor::Zero },
+                    BlendFactor::OneMinusSrcAlpha,
+                );
+                canvas.fill_path(&path, &red);
+            }
+            canvas.restore();
+            let draw = flush_counts(&device, &queue, &mut canvas, &target);
+            canvas.clear_rect(0, 0, SIZE, SIZE, Color::black());
+            let clear = flush_counts(&device, &queue, &mut canvas, &target);
+            let expected_creations = if round == 0 {
+                states
+            } else if states <= capacity {
+                0
+            } else {
+                // The clear survives into the drawing flush but is evicted at its end.
+                states - capacity + 1
+            };
+            assert_eq!(
+                draw.created + clear.created,
+                expected_creations,
+                "{states} states, round {round}: draw {draw:?}, clear {clear:?}"
+            );
+            let expected_draw_resident = if round == 0 || states > capacity {
+                states - 1
+            } else {
+                states
+            };
+            assert_eq!(draw.retained, expected_draw_resident, "{states} states, round {round}");
+            assert_eq!(clear.retained, states.min(capacity), "{states} states, round {round}");
+        }
+        drop(canvas);
+        device
+            .poll(wgpu::PollType::wait_indefinitely())
+            .expect("device poll failed");
+    }
+}
+
+/// Alternating glyph, clipped-layer, filter, screen and clear flushes reuse the
+/// whole working set after their first round.
+#[test]
+fn alternating_flushes_create_pipelines_only_in_the_first_round() {
+    let Some((device, queue)) = headless_device() else {
+        return;
+    };
+    let target = target(&device);
+    let mut canvas = Canvas::new(WGPURenderer::new(device.clone(), queue.clone())).expect("canvas");
+    canvas.set_size(SIZE, SIZE, 1.0);
+    let atlas = canvas
+        .create_image_empty(8, 8, PixelFormat::Gray8, ImageFlags::empty())
+        .expect("glyph atlas");
+    let mut clip = Path::new();
+    clip.circle(32.0, 32.0, 24.0);
+    let red = Paint::color(Color::rgb(255, 0, 0));
+
+    let mut counts = Vec::new();
+    let mut flush = |canvas: &mut Canvas<WGPURenderer>| {
+        counts.push(flush_counts(&device, &queue, canvas, &target));
+    };
+    for _ in 0..3 {
+        let glyph = Quad {
+            x0: 8.0,
+            y0: 8.0,
+            s0: 0.0,
+            t0: 0.0,
+            x1: 16.0,
+            y1: 16.0,
+            s1: 1.0,
+            t1: 1.0,
+        };
+        canvas.draw_glyph_commands(
+            GlyphDrawCommands {
+                alpha_glyphs: vec![DrawCommand {
+                    image_id: atlas,
+                    quads: vec![glyph],
+                }],
+                color_glyphs: Vec::new(),
+            },
+            &red,
+        );
+        flush(&mut canvas);
+
+        canvas.save();
+        canvas.clip_path(&clip, FillRule::NonZero);
+        assert!(canvas.begin_layer(&LayerEffects::new().with_opacity(0.5)));
+        canvas.fill_path(&rect(), &red);
+        canvas.end_layer();
+        canvas.restore();
+        flush(&mut canvas);
+
+        assert!(canvas.begin_layer(&LayerEffects::new().with_filters(&[ImageFilter::GaussianBlur { sigma: 3.0 }])));
+        canvas.fill_path(&rect(), &Paint::color(Color::rgb(0, 0, 255)));
+        canvas.end_layer();
+        flush(&mut canvas);
+
+        draw_frame(&mut canvas);
+        flush(&mut canvas);
+
+        canvas.clear_rect(0, 0, SIZE, SIZE, Color::black());
+        flush(&mut canvas);
+    }
+
+    let round = counts.len() / 3;
+    let settled = counts[round - 1].retained;
+    assert!(counts[..round].iter().map(|count| count.created).sum::<usize>() > 0);
+    for count in &counts[round..] {
+        assert_eq!(count.created, 0, "warmed flush created pipelines: {counts:?}");
+        assert_eq!(count.retained, settled, "warmed flush evicted pipelines: {counts:?}");
+    }
+}
+
+/// Up to capacity a flush evicts nothing, one past it evicts the pipeline used longest ago, and a flush never
+/// evicts what it bound itself. Before the fix a flush binding only pipeline 0 of 63 evicted the other 62.
+#[test]
+fn pipelines_are_evicted_only_past_capacity_least_recently_used_first() {
+    for len in PIPELINE_CACHE_CAPACITY - 1..=PIPELINE_CACHE_CAPACITY + 1 {
+        // Pipeline `i` was last bound in flush `i`; the current flush, a lone clear, rebinds only pipeline 0.
+        let flush = len as u64;
+        let mut cache: HashMap<usize, u64> = (0..len).map(|i| (i, i as u64)).collect();
+        cache.insert(0, flush);
+        evict_least_recently_used(&mut cache, flush, |&last_used| last_used);
+        assert_eq!(cache.len(), len.min(PIPELINE_CACHE_CAPACITY), "pipelines kept of {len}");
+        if len > PIPELINE_CACHE_CAPACITY {
+            assert!(!cache.contains_key(&1), "pipeline 1, used longest ago, was kept");
+        }
+    }
+
+    let len = PIPELINE_CACHE_CAPACITY + 1;
+    let mut cache: HashMap<usize, u64> = (0..len).map(|i| (i, 1)).collect();
+    evict_least_recently_used(&mut cache, 1, |&last_used| last_used);
+    assert_eq!(cache.len(), len, "a flush binding {len} states evicted some of them");
+}
